{
  "version": "2026-11-07",
  "note": "Golden set for the SIP Recovery Assistant. Each case runs through /api/answer on a sample scenario. A case passes when the response type matches `expect` and the shown text meets `must` (all regexes match) and `must_not` (none match). Regexes are case-insensitive.",
  "cases": [
    {
      "id": "G01",
      "cat": "core",
      "scenario": "failed",
      "q": "My SIP payment failed. Does this mean my SIP is cancelled?",
      "expect": "answer",
      "must": [
        "not (been )?cancel|still (active|running)|isn[’']?t cancel",
        "2 of 3|two (missed|in a row)|one more"
      ],
      "must_not": [
        "has been cancelled"
      ]
    },
    {
      "id": "G02",
      "cat": "core",
      "scenario": "failed",
      "q": "How do I pay the instalment that failed?",
      "expect": "answer",
      "must": [
        "pay now|pending sip|dashboard",
        "by \\d{1,2} nov|until|2 working days"
      ],
      "must_not": []
    },
    {
      "id": "G03",
      "cat": "core",
      "scenario": "failed",
      "q": "Will Groww charge me a penalty for the failed payment?",
      "expect": "answer",
      "must": [
        "groww (doesn'?t|does not|won'?t) charge|no (charge|fee) from groww|groww charges nothing",
        "bank"
      ],
      "must_not": [
        "₹ ?(150|250|500|750)\\b"
      ]
    },
    {
